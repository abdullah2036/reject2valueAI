{
  "name": "REJECT2VALUE soft sensor + decision engine",
  "version": "0.1.0",
  "built": "2026-10-15",
  "intended_use": "Decision support for RO plant operators: estimate reject (concentrate) chemistry from online sensors (+ the last feed lab analysis) and rank Reduce / Reuse / Recover (Mg) / Treat-Dispose. Runs fully locally (no external APIs). Not a substitute for lab analysis before capital decisions.",
  "data_sources": [
    {
      "name": "USGS Brackish Groundwater major-ions dataset",
      "citation": "Qi, S.L., and Harris, A.C., 2017, Geochemical Database for the Brackish Groundwater Assessment of the United States, U.S. Geological Survey data release",
      "doi": "https://doi.org/10.5066/F72F7KK1",
      "url": "https://www.sciencebase.gov/catalog/item/58937228e4b0fa1e59b73361"
    },
    {
      "name": "red_sea_jeddah_seawater",
      "citation": "Lenntech seawater composition table (secondary source)"
    },
    {
      "name": "red_sea_standard_ratio_seawater",
      "citation": "Millero et al. 2008, Deep-Sea Research I 55:50-72 (Reference Composition of standard seawater, S=35.165 g/kg), ion ratios scaled to TDS 41000 mg/L; HCO3 from Lenntech table"
    },
    {
      "name": "arabian_gulf_kuwait_seawater",
      "citation": "Lenntech seawater composition table (secondary source)"
    },
    {
      "name": "kfupm_dhahran_brackish",
      "citation": "US patent 9481590, citing KFUPM (Dhahran) RO plant analysis"
    },
    {
      "name": "riyadh_minjur_wasia_brackish",
      "citation": "Riyadh deep aquifers (Minjur / Wasia), RO plants study"
    },
    {
      "name": "riyadh_reject_typical",
      "citation": "National Water Company presentation (Al-Jamaan)"
    },
    {
      "name": "midyan_basin_groundwater",
      "citation": "Ghrefat et al. 2025, Arab Gulf Journal of Scientific Research"
    },
    {
      "name": "saq_aquifer_groundwater",
      "citation": "Saq aquifer, 295 wells (King Saud University study)"
    },
    {
      "name": "makkah_wadi_fatimah_groundwater",
      "citation": "Water 2022, 14(3), 483 (59 wells, Makkah province)"
    },
    {
      "name": "makkah_villages_groundwater",
      "citation": "King Abdulaziz University study, 3 Makkah villages"
    },
    {
      "name": "saudi_signature",
      "citation": "Derived from the profiles above (TDS/EC ranges, ion dominance order, KFUPM and Midyan Ca/Mg/SO4 values)"
    }
  ],
